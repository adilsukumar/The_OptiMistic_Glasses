# OptiMistic Voice Assistant — Configuration & LLM Keys
# Copy this file to .env and insert your API keys

# xAI Grok API Key (Grok-2 / Grok-2-mini / Grok-beta)
# Get your API key at: https://console.x.ai
XAI_API_KEY=
# Or alias:
GROK_API_KEY=
GROK_MODEL=grok-2-mini

# Google Gemini API Key (Gemini 2.0 Flash)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq API Key (Llama 3.3 70B on Groq LPUs)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=

# LLM Provider selection: auto | grok | gemini | groq | ollama | openai | mock
OPTIMISTIC_LLM_PROVIDER=grok

# Local Offline LLM via Ollama (No API key needed, runs 100% locally on your computer)
# Download Ollama at https://ollama.ai and run: ollama run llama3.2:3b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Audio & Voice Settings
OPTIMISTIC_STT_ENGINE=auto
OPTIMISTIC_WAKE_WORD=true
OPTIMISTIC_VAD_SILENCE=7
OPTIMISTIC_VAD_THRESHOLD=0.0030
